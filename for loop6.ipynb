   "source": [
    "n=int(input(\"Enter the value of n:\"))\n",
    "total=0\n",
    "for i in range(1,n+1):\n",
    "    total += i\n",
    "average =total/n\n",
    "print(\"The average of the first\",n,\"natural numbers is:\",average)"
